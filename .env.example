# SYNAPSE ONE environment template.
# Copy to `.env` and fill in values. Never commit the real `.env`.

# --- PostgreSQL (docker compose) ---
DB_PASSWORD=
DB_USER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=synapseone

# --- Local gateway ---
SYNAPSE_API_HOST=127.0.0.1
SYNAPSE_API_PORT=8765

# Optional full override of the database URL. Leave empty to compose from DB_* above.
SYNAPSE_DATABASE_URL=

# Optional: pin the client token instead of using the generated token file.
SYNAPSE_TOKEN=
